# TurboNetwork Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de datos PostgreSQL (Local, VPS o cPanel PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turbonetwork

# Seguridad y Autenticación
JWT_SECRET=turbonetwork_super_secure_jwt_secret_change_in_production_2026

# Parámetros del ISP / SaaS
COMPANY_NAME=TurboNetwork ISP
CURRENCY_SYMBOL=$
DEFAULT_DUE_DAYS=5

# Bot de Automatización (Gemini API - opcional, sin clave funciona con reglas y palabras clave)
GEMINI_API_KEY=
BOT_MODEL=gemini-3.8-flash
BOT_EMBEDDING_MODEL=gemini-embedding-001
BOT_TENANT_ID=

# Módulo de Correos (Clave de cifrado AES-256-GCM para credenciales IMAP/SMTP)
MAIL_ENC_KEY=
