{
  "name": "turbonetwork-saas",
  "version": "1.0.0",
  "description": "Next-Generation High-Performance SaaS for Internet Service Providers (ISP/WISP)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:css": "tailwindcss -i src/styles/input.css -o public/assets/tailwind.min.css --minify",
    "build": "npm run build:css && (tsup || node ./node_modules/tsup/dist/cli-default.js)",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "desktop:install": "npm --prefix desktop install",
    "desktop:start": "npm --prefix desktop run start",
    "desktop:build": "npm --prefix desktop run dist",
    "desktop:portable": "npm --prefix desktop run dist:portable"
  },
  "keywords": [
    "isp",
    "wisp",
    "saas",
    "fastify",
    "typescript",
    "postgresql",
    "drizzle"
  ],
  "author": "TurboNetwork",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/static": "^7.0.4",
    "@jridgewell/gen-mapping": "^0.3.13",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.24.2",
    "drizzle-orm": "^0.33.0",
    "fast-decode-uri-component": "^1.0.1",
    "fastify": "^4.28.1",
    "light-my-request": "^6.6.0",
    "mime": "^4.1.0",
    "postgres": "^3.4.4",
    "rollup": "^4.63.4",
    "source-map": "^0.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
